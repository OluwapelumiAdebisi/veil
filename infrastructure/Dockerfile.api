FROM rust:1.88-bookworm AS rust
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
ENV CARGO_TERM_COLOR=never
RUN cargo build --release -p veil-crypto --bin veil-crypto -p veil-mpc --bin veil-mpc

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY apps/api/package.json apps/api/package-lock.json ./
RUN npm ci
COPY apps/api ./
COPY --from=rust /src/target/release/veil-crypto /src/target/release/veil-mpc /usr/local/bin/
ENV VEIL_CRYPTO_BIN=/usr/local/bin/veil-crypto
ENV VEIL_MPC_BIN=/usr/local/bin/veil-mpc
ENV PORT=8787
EXPOSE 8787
CMD ["npx", "tsx", "src/index.ts"]
